@'
# Secrets and environment variables
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# IDE
.vscode/
.idea/

# Local backups and logs
backups/
*.log

# Local database files
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding utf8